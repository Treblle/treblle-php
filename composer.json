{
  "type": "library",
  "name": "treblle/treblle-php",
  "description": "Stay in tune with your APIs",
  "homepage": "https://treblle.com/",
  "keywords": [
    "treblle",
    "api",
    "monitoring",
    "debuging",
    "documentation",
    "phpunit"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Bhushan Gaikwad",
      "email": "bhushan@treblle.com",
      "homepage": "https://treblle.com/",
      "role": "Developer"
    },
    {
      "name": "Vedran Cindrić",
      "email": "vedran@treblle.com",
      "homepage": "https://treblle.com/",
      "role": "Developer"
    }
  ],
  "autoload": {
    "psr-4": {
      "Treblle\\Php\\": "src/"
    }
  },
  "require": {
    "php": "^8.2",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^7.4.5 || ^8.0 || ^9.0"
  },
  "require-dev": {
    "laravel/pint": "^1.15"
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true
  },
  "scripts": {
    "pint": [
      "./vendor/bin/pint"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
